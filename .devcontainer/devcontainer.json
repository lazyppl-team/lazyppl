{
  "name": "LazyPPL",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "haskell.haskell",
        "justusadam.literate-haskell"
      ],
      "settings": {
        "files.exclude": {
          "dist-newstyle": true
        }
      }
    }
  },
  "containerEnv": {
    "MPLBACKEND": "Agg"
  },
  "postCreateCommand": "cabal build",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  }
}
